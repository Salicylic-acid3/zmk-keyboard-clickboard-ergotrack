#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/zip_dynamic_scale.h>

/ {
    behaviors {
        /* 実行中にポインタ/スクロール速度を変えるビヘイビア */
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        /* 左クリックを押している間だけレイヤー3(ドラッグ)も有効にする。
           これでドラッグ中は両手連携モードが割り込まなくなり、反対側の
           パッドでもカーソルを動かせる = ドラッグの引き継ぎができる */
        /* 左右各1本指を1つのジェスチャーとして扱う。ズーム中はCmdを保持する
           (macOS。Windows/Linuxなら &kp LCTRL に変更) */
        dual_pad: dual_pad {
            compatible = "zmk,input-processor-dual-pad";
            #input-processor-cells = <1>;
            scroll-start = <30>;
            zoom-start = <60>;
            scroll-divisor = <16>;
            zoom-divisor = <24>;
            bindings = <&kp LGUI>;
        };

        drag_lclk: drag_lclk {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mkp LCLK &mo 3>
                     , <&macro_pause_for_release>
                     , <&macro_release &mkp LCLK &mo 3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        default_layer {
            display-name = "Base";
            bindings = <
            &kp ESC        /* RC(0,0) Esc */
            &kp N1         /* RC(0,1) 1 */
            &kp N2         /* RC(0,2) 2 */
            &kp N3         /* RC(0,3) 3 */
            &kp N4         /* RC(0,4) 4 */
            &kp N5         /* RC(0,5) 5 */
            &drag_lclk     /* RC(5,2) Left Click */
            &drag_lclk     /* RC(11,5) Left Click */
            &kp N6         /* RC(6,0) 6 */
            &kp N7         /* RC(6,1) 7 */
            &kp N8         /* RC(6,2) 8 */
            &kp N9         /* RC(6,3) 9 */
            &kp N0         /* RC(6,4) 0 */
            &kp DEL        /* RC(6,5) Delete */
            &kp TAB        /* RC(1,0) Tab */
            &kp Q          /* RC(1,1) Q */
            &kp W          /* RC(1,2) W */
            &kp E          /* RC(1,3) E */
            &kp R          /* RC(1,4) R */
            &kp T          /* RC(1,5) T */
            &kp Y          /* RC(7,0) Y */
            &kp U          /* RC(7,1) U */
            &kp I          /* RC(7,2) I */
            &kp O          /* RC(7,3) O */
            &kp P          /* RC(7,4) P */
            &kp BSPC       /* RC(7,5) Back Space */
            &kp LCTRL      /* RC(2,0) Ctrl */
            &kp A          /* RC(2,1) A */
            &kp S          /* RC(2,2) S */
            &kp D          /* RC(2,3) D */
            &kp F          /* RC(2,4) F */
            &kp G          /* RC(2,5) G */
            &kp H          /* RC(8,0) H */
            &kp J          /* RC(8,1) J */
            &kp K          /* RC(8,2) K */
            &kp L          /* RC(8,3) L */
            &kp MINUS      /* RC(8,4) - */
            &kp RET        /* RC(8,5) Enter */
            &kp LSHFT      /* RC(3,0) Shift */
            &kp Z          /* RC(3,1) Z */
            &kp X          /* RC(3,2) X */
            &kp C          /* RC(3,3) C */
            &kp V          /* RC(3,4) V */
            &kp B          /* RC(3,5) B */
            &drag_lclk     /* RC(5,0) Left Click */
            &drag_lclk     /* RC(11,3) Left Click */
            &kp N          /* RC(9,0) N */
            &kp M          /* RC(9,1) M */
            &kp COMMA      /* RC(9,2) , */
            &kp DOT        /* RC(9,3) . */
            &kp FSLH       /* RC(9,4) / */
            &kp RSHFT      /* RC(9,5) Shift */
            &kp LEFT       /* RC(4,0) Left */
            &kp UP         /* RC(4,1) Up */
            &kp RIGHT      /* RC(4,2) Right */
            &kp SPACE      /* RC(4,3) Space */
            &kp SPACE      /* RC(4,4) Space */
            &kp SPACE      /* RC(4,5) Space */
            &kp SPACE      /* RC(10,0) Space */
            &kp SPACE      /* RC(10,1) Space */
            &kp SPACE      /* RC(10,2) Space */
            &zip_dyn_scale ZDS_XY ZDS_DEC   /* RC(10,3) カーソル速度 - */
            &zip_dyn_scale ZDS_XY ZDS_INC   /* RC(10,4) カーソル速度 + */
            &zip_dyn_scale ZDS_ALL ZDS_RST  /* RC(10,5) 速度リセット */
            &kp DOWN       /* RC(5,1) Dows */
            &drag_lclk     /* RC(5,3) Left Click */
            &mkp MCLK      /* RC(5,4) Middle Click */
            &mkp RCLK      /* RC(5,5) Right Click */
            &drag_lclk     /* RC(11,0) Left Click */
            &mkp MCLK      /* RC(11,1) Middle Click */
            &mkp RCLK      /* RC(11,2) Right Click */
            &zip_dyn_scale ZDS_SC ZDS_INC   /* RC(11,4) スクロール速度 + */

            /* --- ジェスチャー用の仮想キー(Studioで自由に割り当て可) --- */
            &kp LGUI       /* pos72 ピンチ中Cmd押しっぱなし = Cmd+ホイールでズーム(macOS) */
            &kp F13        /* pos73 3本指スワイプ BTN_3 */
            &kp F14        /* pos74 3本指スワイプ BTN_4 */
            &kp F15        /* pos75 3本指スワイプ BTN_5 */
            &kp F16        /* pos76 3本指スワイプ BTN_6 */
            &none          /* pos77 未使用(タッチ状態は dual_pad が直接見る) */
            &none          /* pos78 未使用(2本指トリガーの両手連携は廃止) */
            >;
        };

        /* インデックス1は default-layer 機能(OS別/接続別のベースレイヤー)用に空けておく。
           全キー透過なので、有効になってもレイヤー0がそのまま効く */
        alt_base_layer {
            display-name = "Alt Base";
            bindings = <
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            >;
        };
        /* 左パッド操作中に有効になるレイヤー2。キーは全て透過なので通常のタイピングに影響しない */
        two_hand_layer {
            display-name = "2-Hand";
            bindings = <
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            >;
        };

        /* レイヤー3。左クリック保持中に有効。両手連携より優先されるので、ドラッグ中は
           どちらのパッドでも普通にカーソルが動く */
        drag_layer {
            display-name = "Drag";
            bindings = <
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            &trans
            >;
        };

        /* ZMK Studio から使うための空きレイヤー枠 */
        extra1 { status = "reserved"; };
        extra2 { status = "reserved"; };
        extra3 { status = "reserved"; };
        extra4 { status = "reserved"; };
        extra5 { status = "reserved"; };
    };
};
