#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
            &kp ESC        /* RC(0,0) Esc */
            &kp N1         /* RC(0,1) 1 */
            &kp N2         /* RC(0,2) 2 */
            &kp N3         /* RC(0,3) 3 */
            &kp N4         /* RC(0,4) 4 */
            &kp N5         /* RC(0,5) 5 */
            &mkp LCLK      /* RC(5,2) Left Click */
            &mkp LCLK      /* RC(11,5) Left Click */
            &kp N6         /* RC(6,0) 6 */
            &kp N7         /* RC(6,1) 7 */
            &kp N8         /* RC(6,2) 8 */
            &kp N9         /* RC(6,3) 9 */
            &kp N0         /* RC(6,4) 0 */
            &kp DEL        /* RC(6,5) Delete */
            &kp TAB        /* RC(1,0) Tab */
            &kp Q          /* RC(1,1) Q */
            &kp W          /* RC(1,2) W */
            &kp E          /* RC(1,3) E */
            &kp R          /* RC(1,4) R */
            &kp T          /* RC(1,5) T */
            &kp Y          /* RC(7,0) Y */
            &kp U          /* RC(7,1) U */
            &kp I          /* RC(7,2) I */
            &kp O          /* RC(7,3) O */
            &kp P          /* RC(7,4) P */
            &kp BSPC       /* RC(7,5) Back Space */
            &kp LCTRL      /* RC(2,0) Ctrl */
            &kp A          /* RC(2,1) A */
            &kp S          /* RC(2,2) S */
            &kp D          /* RC(2,3) D */
            &kp F          /* RC(2,4) F */
            &kp G          /* RC(2,5) G */
            &kp H          /* RC(8,0) H */
            &kp J          /* RC(8,1) J */
            &kp K          /* RC(8,2) K */
            &kp L          /* RC(8,3) L */
            &kp MINUS      /* RC(8,4) - */
            &kp RET        /* RC(8,5) Enter */
            &kp LSHFT      /* RC(3,0) Shift */
            &kp Z          /* RC(3,1) Z */
            &kp X          /* RC(3,2) X */
            &kp C          /* RC(3,3) C */
            &kp V          /* RC(3,4) V */
            &kp B          /* RC(3,5) B */
            &mkp LCLK      /* RC(5,0) Left Click */
            &mkp LCLK      /* RC(11,3) Left Click */
            &kp N          /* RC(9,0) N */
            &kp M          /* RC(9,1) M */
            &kp COMMA      /* RC(9,2) , */
            &kp DOT        /* RC(9,3) . */
            &kp FSLH       /* RC(9,4) / */
            &kp RSHFT      /* RC(9,5) Shift */
            &kp LEFT       /* RC(4,0) Left */
            &kp UP         /* RC(4,1) Up */
            &kp RIGHT      /* RC(4,2) Right */
            &kp SPACE      /* RC(4,3) Space */
            &kp SPACE      /* RC(4,4) Space */
            &kp SPACE      /* RC(4,5) Space */
            &kp SPACE      /* RC(10,0) Space */
            &kp SPACE      /* RC(10,1) Space */
            &kp SPACE      /* RC(10,2) Space */
            &trans         /* RC(10,3) (unassigned) */
            &trans         /* RC(10,4) (unassigned) */
            &trans         /* RC(10,5) (unassigned) */
            &kp DOWN       /* RC(5,1) Dows */
            &mkp LCLK      /* RC(5,3) Left Click */
            &mkp MCLK      /* RC(5,4) Middle Click */
            &mkp RCLK      /* RC(5,5) Right Click */
            &mkp LCLK      /* RC(11,0) Left Click */
            &mkp MCLK      /* RC(11,1) Middle Click */
            &mkp RCLK      /* RC(11,2) Right Click */
            &trans         /* RC(11,4) (unassigned) */
            >;
        };
    };
};
