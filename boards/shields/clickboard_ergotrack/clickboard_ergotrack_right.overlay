#include "clickboard_ergotrack.dtsi"
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/zip_dynamic_scale.h>

/ {
    behaviors {
        /* トラックパッドのジェスチャーを仮想キー位置の押下に変換する */
        tp_to_pos: tp_to_pos {
            compatible = "zmk,behavior-trackpad-to-pos";
            #binding-cells = <1>;
        };
    };

    /* REL_X/Y を listener が無視するコードへ付け替えてカーソル移動を捨てる */
    zip_xy_drop: zip_xy_drop {
        compatible = "zmk,input-processor-code-mapper";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        map = <INPUT_REL_X INPUT_REL_MISC>
            , <INPUT_REL_Y INPUT_REL_MISC>;
    };

    /* ジェスチャーのBTNイベントを仮想キー位置へ流し直す(元のマウスボタン出力は中和) */
    trackpad_gestures: trackpad_gestures {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <INPUT_BTN_7 INPUT_BTN_3 INPUT_BTN_4 INPUT_BTN_5 INPUT_BTN_6 INPUT_BTN_8 INPUT_BTN_9>;
        bindings = <
            &tp_to_pos 72
            &tp_to_pos 73
            &tp_to_pos 74
            &tp_to_pos 75
            &tp_to_pos 76
            &tp_to_pos 77
            &tp_to_pos 78
        >;
    };

    /* 実行時に倍率を変えられるスケーラ(値はsettingsに保存され再起動後も維持) */
    zip_dynamic_xy_scaler: zip_dynamic_xy_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        scale-group = <ZDS_XY>;
        track-remainders;
    };

    zip_dynamic_scroll_scaler: zip_dynamic_scroll_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        scale-group = <ZDS_SC>;
        track-remainders;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        input-processors = <
            &trackpad_gestures
            &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
            &zip_xy_transform INPUT_TRANSFORM_X_INVERT
            &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
            &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            &zip_scroll_scaler 1 16
            &zip_dynamic_scroll_scaler
            &zip_dynamic_xy_scaler
        >;
        status = "okay";

        /* レイヤー2(=左クリック保持中)は通常動作。両手連携より先に書くことで優先される */
        drag_mode {
            layers = <2>;
            input-processors = <
                &trackpad_gestures
                &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                &zip_xy_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_scaler 1 16
                &zip_dynamic_scroll_scaler
                &zip_dynamic_xy_scaler
            >;
        };

        /* レイヤー1(=左パッドに触れている)のあいだは、左パッドのカーソル移動を捨てる。
           自分自身の2本指スクロールは通したままにする */
        two_hand_modifier {
            layers = <1>;
            input-processors = <
                &trackpad_gestures
                &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_scaler 1 16
                &zip_dynamic_scroll_scaler
                &zip_xy_drop
            >;
        };
    };

    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        input-processors = <
            &trackpad_gestures
            &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
            &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 1 16
            &zip_dynamic_scroll_scaler
            &zip_dynamic_xy_scaler
        >;
        status = "okay"; 

        /* レイヤー2(=左クリック保持中)は通常動作。両手連携より先に書くことで優先される */
        drag_mode {
            layers = <2>;
            input-processors = <
                &trackpad_gestures
                &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 16
                &zip_dynamic_scroll_scaler
                &zip_dynamic_xy_scaler
            >;
        };

        /* レイヤー1(=左パッド操作中)のあいだは、右パッドの移動をスクロールに変換 */
        two_hand_scroll {
            layers = <1>;
            input-processors = <
                &trackpad_gestures
                &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
                &zip_xy_to_scroll_mapper
                &zip_scroll_scaler 1 16   /* ← 両手スクロールの速度調整はこの 16 を変える */
                &zip_dynamic_scroll_scaler
            >;
        };
    };
};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    row-gpios = <&akdk_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    col-gpios = <&akdk_d 3 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 4 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 5 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 6 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 12 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 13 (GPIO_ACTIVE_HIGH)>;
    wakeup-source;
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 9)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 9)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
    zephyr,concat-buf-size = <32>;

    trackpad: trackpad@56 {
        status = "okay";
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        irq-gpios = <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; 
    };
};