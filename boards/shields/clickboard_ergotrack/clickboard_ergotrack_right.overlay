#include "clickboard_ergotrack.dtsi"
#include <dt-bindings/pinctrl/nrf-pinctrl.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/zip_dynamic_scale.h>

/ {
    behaviors {
        /* トラックパッドのジェスチャーを仮想キー位置の押下に変換する */
        tp_to_pos: tp_to_pos {
            compatible = "zmk,behavior-trackpad-to-pos";
            #binding-cells = <1>;
        };
    };

    /* 左右各1本指を1つのジェスチャーとして扱う。ズーム中はCmdを保持する
       (macOS。Windows/Linuxなら &kp LCTRL に変更) */
    dual_pad: dual_pad {
        compatible = "zmk,input-processor-dual-pad";
        #input-processor-cells = <2>;
        scroll-start = <30>;
        zoom-start = <60>;
        scroll-divisor = <16>;
        zoom-divisor = <24>;
        invert-scroll;
        invert-zoom;
        /* 修飾キーは直接指定せず仮想キー位置(pos77)を叩く。こうするとレイヤーで
           解決されるので、OS判定でレイヤーを切り替えれば修飾キーも一緒に変わるし、
           Keeb-On! Studio から再ビルドなしで変更できる */
        bindings = <&tp_to_pos 77>;
    };

    /* ジェスチャーのBTNイベントを仮想キー位置へ流し直す(元のマウスボタン出力は中和) */
    trackpad_gestures: trackpad_gestures {
        compatible = "zmk,input-processor-behaviors-consume";
        #input-processor-cells = <0>;
        type = <INPUT_EV_KEY>;
        codes = <INPUT_BTN_7 INPUT_BTN_3 INPUT_BTN_4 INPUT_BTN_5 INPUT_BTN_6>;
        bindings = <
            &tp_to_pos 72
            &tp_to_pos 73
            &tp_to_pos 74
            &tp_to_pos 75
            &tp_to_pos 76
        >;
    };

    /* 実行時に倍率を変えられるスケーラ(値はsettingsに保存され再起動後も維持) */
    zip_dynamic_xy_scaler: zip_dynamic_xy_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_X INPUT_REL_Y>;
        scale-group = <ZDS_XY>;
        track-remainders;
    };

    zip_dynamic_scroll_scaler: zip_dynamic_scroll_scaler {
        compatible = "zmk,input-processor-dynamic-scaler";
        #input-processor-cells = <0>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        scale-group = <ZDS_SC>;
        track-remainders;
    };

    split_inputs {
        #address-cells = <1>;
        #size-cells = <0>;

        pointing_device_split: pointing_device_split@0 {
            compatible = "zmk,input-split";
            reg = <0>;
        };
    };

    pointing_device_split_listener: pointing_device_split_listener {
        compatible = "zmk,input-listener";
        device = <&pointing_device_split>;
        input-processors = <
            &trackpad_gestures
            &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
            &zip_xy_transform INPUT_TRANSFORM_X_INVERT
            &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
            &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
            &zip_scroll_scaler 1 16
            &zip_dynamic_scroll_scaler
            &zip_dynamic_xy_scaler
            &dual_pad 0 0
        >;
        status = "okay";

        /* レイヤー3(=左クリック保持中)は通常動作。両手連携より先に書くことで優先される */
        drag_mode {
            layers = <2>;
            input-processors = <
                &trackpad_gestures
                &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                &zip_xy_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
                &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
                &zip_scroll_scaler 1 16
                &zip_dynamic_scroll_scaler
                &zip_dynamic_xy_scaler
            >;
        };
    };

    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&trackpad>;
        input-processors = <
            &trackpad_gestures
            &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
            &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
            &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
            &zip_scroll_scaler 1 16
            &zip_dynamic_scroll_scaler
            &zip_dynamic_xy_scaler
            &dual_pad 1 0
        >;
        status = "okay"; 

        /* レイヤー3(=左クリック保持中)は通常動作。両手連携より先に書くことで優先される */
        drag_mode {
            layers = <2>;
            input-processors = <
                &trackpad_gestures
                &zip_xy_transform INPUT_TRANSFORM_XY_SWAP
                &zip_xy_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_transform INPUT_TRANSFORM_XY_SWAP
                &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT
                &zip_scroll_scaler 1 16
                &zip_dynamic_scroll_scaler
                &zip_dynamic_xy_scaler
            >;
        };
    };

    /* --- Keeb-On! Studio にトラックパッドの位置を伝える ---
       キーの物理レイアウトは ZMK 公式のプロトコルで送られるが、キー以外の
       部品(トラックパッド/トラックボール/エンコーダー)は公式プロトコルに
       口が無い。zmk-feature-module-physical-layout がその口を足していて、
       アプリはこれを読んでキーマップ画面にパッドを描く。
       このノードが無いとアプリ側は「モジュール無し」と判断して何も描かない。

       座標系はキーの物理レイアウト(clickboard_ergotrack-layouts.dtsi)と同じ。
       100 = 1u。キーは x 0..1925 / y 0..800 の範囲にあるので、パッドはその
       下(y=820)に、左右それぞれの主要キー列の中央へ置いてある。
       実機の見た目と合わなければこの4つの数値だけ動かせばよい。 */

    touchpad_left: touchpad_left {
        compatible = "cormoran,physical-layout-touch-pad";
        display-name = "Touch Pad (Left)";
        width = <240>;
        height = <180>;
        x = <205>;
        y = <820>;
        linked-device-identifiers = "trackpad_left";
        linked-subsystems = "zmk__touch_pad";
    };

    touchpad_right: touchpad_right {
        compatible = "cormoran,physical-layout-touch-pad";
        display-name = "Touch Pad (Right)";
        width = <240>;
        height = <180>;
        x = <1480>;
        y = <820>;
        linked-device-identifiers = "trackpad_right";
        linked-subsystems = "zmk__touch_pad";
    };

};

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    diode-direction = "col2row";
    row-gpios = <&akdk_d 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
        <&akdk_d 16 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    col-gpios = <&akdk_d 3 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 4 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 5 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 6 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 12 (GPIO_ACTIVE_HIGH)>,
        <&akdk_d 13 (GPIO_ACTIVE_HIGH)>;
    wakeup-source;
};

&pinctrl {
    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 9)>;
            bias-pull-up;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 12)>,
                    <NRF_PSEL(TWIM_SCL, 1, 9)>;
            bias-pull-up;
            low-power-enable;
        };
    };
};

&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;
    zephyr,concat-buf-size = <32>;

    trackpad: trackpad@56 {
        status = "okay";
        compatible = "azoteq,iqs9151";
        reg = <0x56>;
        irq-gpios = <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; 
    };
};